{
  "name": "flutter-auto-installer",
  "version": "1.0.0",
  "buildNumber": 1,
  "description": "Desktop One-Click Auto Installer for Flutter & Android SDK",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "test": "echo \"No test specified\""
  },
  "keywords": [
    "flutter",
    "installer",
    "android-sdk",
    "electron"
  ],
  "author": "Rizki Abdul Gofur",
  "license": "MIT",
  "build": {
    "appId": "com.rizki.flutterinstaller",
    "productName": "Flutter Auto Installer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/flutter-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/flutter-logo.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/flutter-logo.png",
      "category": "Development"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
